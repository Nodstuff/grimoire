[Unit]
Description=Taisce daemon (SERVER mode)
After=network-online.target
Wants=network-online.target

[Service]
User=taisce
Group=taisce
Environment=HOME=/var/lib/taisce
Environment=TAISCE_PUBLIC_URL=https://taisce.null.ie
Environment=TAISCE_TRUSTED_PROXY=true
ExecStartPre=-+/opt/taisce/bin/apns-key.sh
ExecStartPre=-+/opt/taisce/bin/share-key.sh
Environment=TAISCE_APNS_KEY_FILE=/run/taisce/apns.p8
Environment=TAISCE_APNS_KEY_ID=WT3Q587Y97
Environment=TAISCE_APNS_TEAM_ID=6UP35L9425
Environment=TAISCE_APNS_TOPIC=ie.null.taisce
Environment=TAISCE_APNS_ENV=production
# the EPUB library (library/<user>/… in the backups bucket; the instance
# role's credentials via IMDS). The region is required with the bucket.
Environment=TAISCE_BOOKS_BUCKET=taisce-backups-895102116452
Environment=TAISCE_BOOKS_REGION=eu-west-1
ExecStart=/opt/taisce/bin/taisce --db /var/lib/taisce/ks.db --port 7425 serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/taisce
RuntimeDirectory=taisce
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
